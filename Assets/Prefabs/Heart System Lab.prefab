  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The moderator band, also known as the septomarginal trabecula,
    is a muscular column within the right ventricle of the heart.


    Location:
    It extends from the lower part of the interventricular septum and connects to
    the anterior papillary muscle in the right ventricle.


    Function: The moderator
    band carries a portion of the right branch of the bundle of His, an essential
    component of the heart''s electrical conduction system. This ensures a more coordinated
    contraction of the right ventricle, facilitating efficient blood ejection to
    the pulmonary artery.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
