  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The interatrial septum is a thin wall that separates the
    heart''s two atria, the left and right atrium.



    Location: Positioned centrally
    within the heart, it divides the left and right atria.



    Function: Its primary
    role is to prevent the mixing of oxygenated and deoxygenated blood between the
    left and right sides of the heart. Anomalies in the interatrial septum, like
    patent foramen ovale or atrial septal defects, can lead to abnormal blood flow
    patterns.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
