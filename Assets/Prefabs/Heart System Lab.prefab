  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The coronary sinus is a large venous channel that collects
    blood from the heart''s myocardium.


    Location: It is located in the heart''s
    posterior part, within the atrioventricular (coronary) sulcus, and runs from
    left to right before draining into the right atrium.


    Function: The coronary
    sinus returns oxygen-depleted blood from the myocardium of the heart to the right
    atrium, ensuring that the heart tissue itself receives oxygen and nutrients and
    disposes of waste products.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
