  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The left atrium is one of the heart''s four main chambers
    and serves as a receiving chamber for oxygen-rich blood.



    Location: Positioned
    in the heart''s upper left portion, it lies just above the left ventricle and
    is adjacent to the right atrium.



    Function: The left atrium receives oxygenated
    blood from the lungs via the pulmonary veins. Upon filling, it contracts and
    pushes the blood through the bicuspid (mitral) valve into the left ventricle,
    readying the blood for distribution to the body.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
