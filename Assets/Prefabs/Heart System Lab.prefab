  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: Papillary muscles are finger-like projections of muscle within
    the ventricles of the heart.


    Location: They arise from the myocardial wall
    and attach to the chordae tendineae, which are thin, cord-like tendons.


    Function:
    Their primary role is to prevent the backflow of blood. During heart contraction,
    they contract to keep the atrioventricular valves (mitral and tricuspid) closed,
    ensuring that blood flows in the correct direction, from the atria to the ventricles
    and out into the circulation.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
