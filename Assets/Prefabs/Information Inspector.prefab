  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The left humerus is the long bone of the upper arm, extending from the
    shoulder to the elbow. Proximally, its rounded head articulates with the glenoid
    fossa of the scapula, constituting the glenohumeral (shoulder) joint. The humerus
    features two prominent processes near its proximal end: the greater and lesser
    tubercles, which serve as attachment points for rotator cuff muscles.  The humerus
    plays a pivotal role in upper limb movement, facilitating actions like flexion,
    extension, and rotation. Its positioning and functions make it susceptible to
    specific injuries, most notably fractures, especially in the elderly or those
    with weakened bone health.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
