  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The phalanges of the left foot are the bones that make up the toes, and
    their configuration is analogous to the phalanges of the fingers. They are classified
    into three types based on their position:

    Proximal Phalanges: These are
    the largest and are closest to the metatarsals. Each toe, except the big toe,
    possesses one proximal phalanx.

    Middle Phalanges: Found in the four smaller
    toes, these are located between the proximal and distal phalanges.

    Distal
    Phalanges: These are the terminal bones of the toes, found at the tip.

    However,
    the big toe (hallux) has only two phalanges: a proximal and a distal, lacking
    a middle phalanx.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
