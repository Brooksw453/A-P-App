      m_Calls: []
  m_text: "Description: The right pulmonary veins are blood vessels responsible for
    conveying oxygen-rich blood from the lungs back to the heart.\r\n\r\nLocation:
    Typically, two right pulmonary veins can be found \u2013 an upper and a lower.
    They arise from the right lung and drain into the posterior aspect of the left
    atrium.\r\n\r\nFunction: These veins serve the crucial function of transporting
    oxygenated blood from the right lung into the left atrium, from where it will
    be directed to the rest of the body."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
