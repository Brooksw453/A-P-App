  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The right coronary artery (RCA) is one of the principal arteries
    responsible for providing oxygenated blood to the heart muscle.



    Location:
    Emerging from the aorta''s right sinus of Valsalva, the RCA descends within the
    atrioventricular (AV) groove, wrapping around the heart''s right posterior side.



    Function:
    The RCA primarily nourishes the right side of the heart. It supplies blood to
    the right atrium, right ventricle, sinoatrial (SA) node, and atrioventricular
    (AV) node. The consistent blood flow from the RCA is essential for the heart''s
    electrical conductivity and overall function.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
