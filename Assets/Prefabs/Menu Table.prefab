  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The aortic semilunar valve, commonly referred to as the aortic
    valve, is a three-cusp or tri-leaflet valve that regulates blood flow between
    the left ventricle and the aorta.


    Location: Positioned at the exit of the
    left ventricle, leading into the ascending aorta.


    Function: During the
    contraction phase (systole) of the heart, the valve opens, allowing oxygen-rich
    blood from the left ventricle to flow into the aorta for distribution throughout
    the body. During the relaxation phase (diastole), the valve closes to prevent
    the backflow of blood from the aorta into the left ventricle.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
