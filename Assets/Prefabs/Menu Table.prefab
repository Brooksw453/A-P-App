  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Description: The left pulmonary veins are vessels that transport oxygen-rich
    blood from the lungs back to the heart.\r\n\r\nLocation: There are typically
    two left pulmonary veins \u2013 an upper and a lower. They emerge from the left
    lung and extend to the left atrium's posterior surface.\r\n\r\nFunction: Their
    primary function is to carry oxygenated blood from the left lung to the left
    atrium, contributing to the heart's supply of oxygenated blood to be pumped throughout
    the body."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
