  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Description: The inferior vena cava (IVC) is the largest vein in the body,
    responsible for transporting deoxygenated blood from the lower half of the body
    back to the heart.



    Location: It ascends alongside the spine and enters
    the lower part of the right atrium of the heart.



    Function: The IVC carries
    oxygen-depleted blood from the lower limbs, pelvis, and abdominal organs back
    to the heart, specifically delivering it to the right atrium.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
